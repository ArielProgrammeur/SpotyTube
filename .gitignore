__pycache__/
node_modules/
.expo/
*.apk
*.aab

# Éditeur et système
.vscode/
.DS_Store

# Local databases
*.db
*.sqlite
*.sqlite3

# Python backend
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Secrets and environment
.env
backend/.env

